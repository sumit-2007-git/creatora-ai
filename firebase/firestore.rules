rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can only write to their own profile
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // Creator profiles: public read for discovery, write only by owning creator
    match /creators/{creatorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Brand profiles: authenticated read, write only by owning brand
    match /brands/{brandId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Campaign briefs: public/authenticated read, write only by creating brand
    match /briefs/{briefId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.brandUid == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // Portfolio items: public read, write only by owning creator
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Applications: creator applies, brand reviews
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.brandUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.brandUid == request.auth.uid || resource.data.creatorUid == request.auth.uid);
    }

    // Inquiries: brand contacts creator directly
    match /inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (resource.data.brandUid == request.auth.uid || resource.data.creatorUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.brandUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.creatorUid == request.auth.uid || resource.data.brandUid == request.auth.uid);
    }

    // Public / analytical social data
    match /{collection}/{documentId} {
      allow read: if collection in ['instagram', 'youtube'];
      allow write: if false; // Writes handled via backend service
    }
  }
}
